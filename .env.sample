# Required Telegram MTProto & Bot credentials
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef
BOT_TOKEN=1234567890:AAH_your_bot_token_here
OWNER_ID=123456789

# Database (Motor MongoDB URI; leave empty to use local SQLite fallback)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=watermark_bot

# Optional Channels
LOG_CHANNEL=0
FORCE_SUB_CHANNEL=

# Queue & Resource Configuration
MAX_CONCURRENT_JOBS=1
MAX_USER_QUEUE=2
MIN_FREE_DISK_MB=250
TEMP_DIR=/tmp/watermark_bot
